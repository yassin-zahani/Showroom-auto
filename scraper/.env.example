# Copie ce fichier en `.env`, modifie, puis lance :  npm run start:env
# (après CHAQUE modification de .env ou de sources.config.json, relance le serveur)

PORT=3000

# Quelle source de données ?
#   mock           données de démonstration, aucun site contacté (défaut)
#   books-demo     VRAI scraping d'un site d'entraînement (books.toscrape.com, prix de livres en £)
#   automobile-tn  parseur dédié à automobile.tn (demande ALLOW_LIVE_SCRAPING=yes)
#   <ton-nom>      n'importe quelle entrée que tu ajoutes dans sources.config.json
SCRAPER_SOURCE=mock

# Garde-fou : les sources qui ont des conditions d'utilisation (automobile-tn, ou les tiennes avec
# "requiresOptIn": true) ne démarrent QUE si tu écris explicitement "yes" ici.
ALLOW_LIVE_SCRAPING=no

# Origine autorisée par CORS (inutile en développement : le proxy d'Angular s'en charge).
ALLOWED_ORIGIN=http://localhost:4200

# Un robot poli s'identifie et donne un moyen de le contacter. Mets ta vraie adresse.
SCRAPER_USER_AGENT=ShowroomAutoBot/1.0 (projet pédagogique; contact: toi@exemple.tn)

CACHE_TTL_MINUTES=360
