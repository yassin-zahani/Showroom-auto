{
  "name": "showroom-scraper",
  "version": "1.0.0",
  "private": true,
  "description": "Petit serveur Node qui calcule des statistiques de prix du marché tunisien pour le showroom Angular.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
